# Public hostname accessible from your Android device running BitChord
PUBLIC_HOST=https://api.yourdomain.com

# Secret key protecting your endpoints from crawlers and bots.
# When set, BitChord must be configured with:
#   https://api.yourdomain.com/YOUR_SECRET_TOKEN/manifest.json
ACCESS_TOKEN=replace_with_a_random_secret

# Deezer ARL token from browser cookies (e.g. 64-char string)
DEEZER_ARL=your_deezer_arl_token_here

# Tidal country code (ISO 3166-1 alpha-2)
TIDAL_COUNTRY_CODE=ID

# Tidal Android OAuth client credentials (extracted from Tidal APK).
# Override here if Tidal rotates these without requiring a code change.
TIDAL_CLIENT_ID=zU4XHVVkc2tDPo4t
TIDAL_CLIENT_SECRET=VJKhDFqJPqvsPVNBV6ukXTJmwlvbttP7wlMlrc72se4=

# Optional: separate HMAC signing secret for /audio/ and /dash/ proxy URLs.
# Falls back to ACCESS_TOKEN when unset — only set this if you need
# audio URL signing to be independent from the path-prefix token.
# AUDIO_SIGNING_SECRET=replace_with_another_random_secret

# Provider priority: "tidal" or "deezer"
PREFERRED_PROVIDER=deezer

# Automatic cross-provider fallback if primary provider fails
ENABLE_FALLBACK=true

# Enable /diag/* routes for debugging (exposes your Tidal Bearer token to callers -- keep false in production)
DIAG_ENABLED=false