# Public hostname accessible from your Android device running BitChord (HTTPS required)
PUBLIC_HOST=https://addon.yourdomain.com

# Optional security token protecting your endpoints from crawlers and leeching
# When configured, BitChord must be configured with:
# https://addon.yourdomain.com/YOUR_SECRET_TOKEN/manifest.json
ACCESS_TOKEN=your_custom_secret_key_here

# Deezer ARL token extracted from browser cookies (64-character hexadecimal)
DEEZER_ARL=your_deezer_arl_token_here

# Tidal Country Code (e.g. US, GB, ID, etc.)
TIDAL_COUNTRY_CODE=ID

# Provider priority: "tidal" or "deezer"
PREFERRED_PROVIDER=tidal

# Automatic cross-provider fallback if primary provider fails
ENABLE_FALLBACK=true