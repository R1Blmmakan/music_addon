# Public hostname accessible from your Android device running BitChord
PUBLIC_HOST=https://addon.yourdomain.com

# Optional security token to prevent unauthorized bot scraping and leeching
# When set, BitChord must be configured with:
# https://addon.yourdomain.com/YOUR_SECRET_TOKEN/manifest.json
ACCESS_TOKEN=your_custom_secret_key_here

# Deezer ARL token from browser cookies (e.g. 64-char string)
DEEZER_ARL=your_deezer_arl_token_here

# Upstream Tidal API URL (optional, leave empty if using Deezer only)
TIDAL_API_URL=http://localhost:8080

# Provider priority: "tidal" or "deezer"
PREFERRED_PROVIDER=deezer

# Enable automatic cross-provider fallback if primary fails
ENABLE_FALLBACK=false
